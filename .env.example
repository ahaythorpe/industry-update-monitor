# Industry Update Monitor — configuration
# Copy this to .env and fill in your values
# .env is git-ignored and should never be committed


# Optional: Email digest (Gmail app password)
# Required only if you use --email flag or set USE_EMAIL = True in src/monitor.py
# Generate an app password at: https://myaccount.google.com/apppasswords
# (Select "Mail" and your device; Google generates a 16-character password)
EMAIL_ADDRESS=your-gmail@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: the digest on your phone, via your own Telegram bot — free.
# Required only for --telegram. Without these, --telegram prints a preview of
# the exact messages instead of sending. Setup: SETUP.md Part 5.
# The token comes from @BotFather (/newbot) — treat it as a password.
# The chat ID is your own chat with the bot; press Start on the bot, then see
# SETUP.md Part 5 step 5 to find it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Retired 23 Sep 2026: WhatsApp via Twilio. Optional, not recommended — every
# WhatsApp route ends up costing money. --whatsapp still works if these are
# set; see archive/WHATSAPP_TWILIO_RETIRED.md.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_WHATSAPP_NUMBER=+14155238886
# WHATSAPP_TO=+61400000000

# Optional: where the dashboard is online, once it is (a private link behind a
# login). When set, the weekly email and Telegram message become a short
# Act now alert with a link here, instead of the full newsletter and file.
# Leave empty until the dashboard is online, or readers get a dead link.
DASHBOARD_URL=

# Local model for --ollama; must be one `ollama list` shows
OLLAMA_MODEL=qwen3:8b
