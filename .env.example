# Advice Monitor Configuration
# Copy this to .env and fill in your values
# .env is git-ignored and should never be committed

# Optional: AI summarisation (Claude Haiku)
# Set to your Anthropic API key if you want AI summaries
ANTHROPIC_API_KEY=sk-...

# Optional: Email digest (Gmail app password)
# Required only if you use --email flag or set USE_EMAIL = True in src/monitor.py
# Generate an app password at: https://myaccount.google.com/apppasswords
# (Select "Mail" and your device; Google generates a 16-character password)
EMAIL_ADDRESS=your-gmail@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
