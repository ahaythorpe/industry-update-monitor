# Industry Update Monitor — configuration
# Copy this to .env and fill in your values
# .env is git-ignored and should never be committed


# Optional: Email digest (Gmail app password)
# Required only if you use --email flag or set USE_EMAIL = True in src/monitor.py
# Generate an app password at: https://myaccount.google.com/apppasswords
# (Select "Mail" and your device; Google generates a 16-character password)
EMAIL_ADDRESS=your-gmail@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: WhatsApp digest via Twilio
# Required only for --whatsapp. Without these, --whatsapp prints a preview
# of the exact messages instead of sending, which costs nothing.
# Sandbox access: https://www.twilio.com/whatsapp/request-access
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886
WHATSAPP_TO=+61400000000

# Local model for --ollama; must be one `ollama list` shows
OLLAMA_MODEL=qwen3:8b
